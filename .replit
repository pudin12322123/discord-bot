modules = ["nodejs-24"]

run = "pnpm --filter @workspace/discord-bot run dev"

[deployment]
router = "application"
deploymentTarget = "vm"
run = ["node", "bots/discord-bot/src/index.js"]

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot"

[[workflows.workflow]]
name = "Discord Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node bots/discord-bot/src/index.js"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
